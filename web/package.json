{
  "name": "noir-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/generate-sw-manifest.mjs && node scripts/precompress.mjs && node scripts/check-build.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --pretty false",
    "test:viewports": "node scripts/viewport-check.mjs",
    "lint": "oxlint src",
    "check:build": "node scripts/check-build.mjs"
  },
  "dependencies": {
    "@ant-design/icons": "6.3.4",
    "@radix-ui/colors": "3.0.0",
    "@tanstack/react-query": "5.107.1",
    "@yume-chan/adb": "2.6.4",
    "@yume-chan/adb-credential-web": "2.1.0",
    "@yume-chan/adb-daemon-webusb": "2.3.2",
    "antd": "6.7.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.5"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/w3c-web-usb": "1.0.14",
    "@vitejs/plugin-react": "6.2.1",
    "fflate": "0.8.3",
    "jsdom": "31.0.0",
    "oxlint": "1.93.0",
    "playwright-core": "1.65.1",
    "typescript": "7.0.2",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  },
  "engines": {
    "node": ">=24.15.0"
  }
}
