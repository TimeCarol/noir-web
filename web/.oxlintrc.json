{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "env": {
    "browser": true,
    "es2022": true
  },
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "perf": "warn"
  },
  "rules": {
    "no-console": "off",
    "no-empty": "off",
    "unicorn/no-array-sort": "off"
  },
  "ignorePatterns": [
    "dist/**",
    "node_modules/**",
    "test-results/**"
  ]
}